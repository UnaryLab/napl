#!/bin/sh
# Refuse a commit unless `make sweep` is green, for any staged path the sweep's
# result depends on.
#
# Install with `make install-hooks` from src/napl/imp/, which points
# core.hooksPath at this directory. Bypass one commit with `git commit
# --no-verify`.
#
# The trigger covers every tree golden-vector generation imports, not just the
# RTL tree: generators build their expected outputs THROUGH the live Python
# classes (operation/_gen_common.py imports napl.sim.operation, module
# generators import napl.sim.module, mapping assertions import napl.syn), so a
# change under src/napl/sim/, src/napl/syn/, or src/napl/utils/ can invalidate
# every vector in the tree. tests/syn/ is the translate step the sweep runs, and
# .githooks/ is this hook itself. Over-triggering costs a ~2-minute sweep;
# under-triggering is a silent hole, so do not narrow this list.
#
# ponytail: the sweep runs against the working tree, not the staged index, so a
# partially staged change is verified as it sits on disk. Stash-and-rerun if the
# distinction ever matters.
set -e

root=$(git rev-parse --show-toplevel)
if ! git diff --cached --name-only | grep -qE '^(src/napl/(imp|sim|syn|utils)/|tests/syn/|\.githooks/)'; then
    exit 0
fi

echo "pre-commit: a path the RTL sweep depends on changed, running make sweep"
if (cd "$root/src/napl/imp" && conda run -n napl --no-capture-output make sweep); then
    exit 0
fi

echo
echo "*** COMMIT REFUSED: make sweep is not green."
echo "*** Fix the red targets above, or commit with --no-verify to bypass deliberately."
exit 1
